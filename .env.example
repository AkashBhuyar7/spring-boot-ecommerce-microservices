# Optional overrides for docker-compose.yaml. Copy to .env and change the values you need.
# Every value has a default in docker-compose.yaml, so the stack also starts without a .env file.
# These are local development credentials only: never reuse them anywhere else.

# SQL Server "sa" password, used by SQL Server and by inventory-service and order-service.
# SQL Server requires at least 8 characters from 3 of: uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=LocalDev_Passw0rd

# Keycloak admin console login (http://localhost:8181)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
